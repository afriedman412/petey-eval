# API keys for benchmark extraction
# Only needed for the models/parsers you want to test

# LLM providers
OPENAI_API_KEY=          # GPT-4.1, GPT-5, GPT-5.4
ANTHROPIC_API_KEY=       # Claude Sonnet, Claude Haiku
GEMINI_API_KEY=          # Gemini Flash
DEEPSEEK_API_KEY=        # DeepSeek

# Parser APIs
DATALAB_API_KEY=         # Datalab parser
UNSTRUCTURED_API_KEY=    # Unstructured parser

# GCS (optional — for --gcs upload and PDF download)
# On Cloud Run, uses default service account automatically
# Locally, set up Application Default Credentials:
#   gcloud auth application-default login
